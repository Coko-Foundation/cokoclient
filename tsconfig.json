{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "maxNodeModuleJsDepth": 10,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "ui/*": ["src/ui/*"],
      "pages/*": ["src/pages/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "vite/**/*.ts",
    "dev/**/*.ts",
    "dev/**/*.tsx"
  ]
}
