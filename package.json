{
  "name": "@coko/client",
  "version": "1.2.2",
  "description": "Client side common code for coko apps",
  "keywords": [
    "coko"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coko-Foundation/cokoclient.git"
  },
  "license": "MIT",
  "author": "Yannis Barlas",
  "type": "module",
  "main": "dist",
  "bin": {
    "coko-client-build": "./scripts/coko-client-build.mjs",
    "coko-client-dev": "./scripts/coko-client-dev.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "vite"
  ],
  "scripts": {
    "build": "npx babel --delete-dir-on-start src --out-dir dist",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf dev/server/node_modules",
    "commit": "yarn coko-lint commit",
    "commitlint": "./node_modules/.bin/commitlint",
    "prepare": "husky install",
    "prepack": "yarn run build",
    "release": "standard-version",
    "typecheck": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "resolutions": {
    "postcss": "8"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.50.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "antd": "^6.3.7",
    "apollo-upload-client": "^19.0.0",
    "color": "^5.0.3",
    "dayjs": "^1.11.20",
    "graphql": "^16.13.2",
    "graphql-ws": "^6.0.8",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "rxjs": "^7.8.2",
    "styled-components": "^6.4.1",
    "styled-normalize": "^8.1.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@apollo/client": "^4.1.9",
    "@coko/lint": "^3.0.0-alpha.28",
    "@faker-js/faker": "^10.4.0",
    "@fontsource/advent-pro": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "inversify": "^7.11.0",
    "standard-version": "^9.5.0"
  },
  "peerDependencies": {
    "@apollo/client": "^4.1.3",
    "react": "^19.2.4",
    "react-router": "^7.13.0",
    "styled-components": "^6.3.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.12.0"
}
